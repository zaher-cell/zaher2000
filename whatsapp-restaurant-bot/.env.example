# .env example — DO NOT COMMIT REAL SECRETS
# Copy this file to `.env` and fill values before running the app.

# MongoDB Atlas connection string (replace <username>, <password>, <cluster> and <dbname>)
# Example:
# mongodb+srv://restaurant-bot-app:password@cluster0.abcde.mongodb.net/restaurant-bot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Port (Railway sets this automatically; keep default for local dev)
PORT=8080

# ==================== Authentication (JWT) ====================
# Long random secret used to sign JWT tokens. Keep this private — do NOT share.
JWT_SECRET=<replace-with-a-long-random-string>

# Admin password for the web dashboard (used if Admin.passwordHash not set)
ADMIN_PASSWORD=<choose-a-strong-password>

# Activation code that the first WhatsApp sender can use to become the hidden admin
ADMIN_ACTIVATION_CODE=zaher2006
